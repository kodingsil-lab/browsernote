# Reference only: deploy-cpanel.sh generates .env in shared/ and preserves it on update.
CI_ENVIRONMENT = production
app.baseURL = 'https://note.sil.web.id/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

database.default.DBDriver = SQLite3
database.default.database = browsernote.sqlite
database.default.DBPrefix = ''
database.default.DBDebug = false
database.default.foreignKeys = true
database.default.busyTimeout = 5000

# Generated randomly by the deployment helper; never copy a shared sample key.
encryption.key = ''
logger.threshold = 3
